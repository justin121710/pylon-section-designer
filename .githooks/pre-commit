#!/bin/sh
# 操作教學與常見問題 PDF 改為「合併（推送）到 main 時」由 GitHub Actions（tutorial-pdf.yml）重建並推回 main，
# 分支提交不附 PDF（避免每個提交讓儲存庫增加約 13 MB）。本 hook 只提示，不阻擋提交。
# 啟用：git config core.hooksPath .githooks
ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0
sh docs/tutorial/check.sh >/dev/null 2>&1 && exit 0
echo "i 操作教學／常見問題 PDF 與目前程式不同步；合併到 main 後由 GitHub Actions 自動重建（分支上不需重建）。"
echo "  介面、步驟或檢核有變時，仍請同步修改 docs/tutorial/tutorial.html 與 faq.html 的文字。"
exit 0
